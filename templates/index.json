    "flipzy_faq_txdnRa": {
      "type": "flipzy-faq",
      "blocks": {
        "faq_item_GPDJVk": {
          "type": "faq_item",
          "settings": {
            "question": "What is Flipzy?",
            "answer": "<p>Flipzy is a hands-on routine board designed to help children complete daily tasks independently—without constant reminders, pressure, or conflict. Kids flip wooden tiles as they finish tasks, turning routines into something visual, tactile, and satisfying.</p>"
          }
        },
        "faq_item_yNfrHx": {
          "type": "faq_item",
          "settings": {
            "question": "What age is Flipzy for?",
            "answer": "<p>Flipzy is for children aged 3+. It contains small parts and requires adult setup and supervision. Choose routine steps that suit your child’s abilities and support them as they learn.</p>"
          }
        },
        "faq_item_AHPRqe": {
          "type": "faq_item",
          "settings": {
            "question": "Is Flipzy suitable for children with special needs?",
            "answer": "<p>Some children find visual routines helpful, but needs vary. Adapt the steps with your child and ask a relevant professional for individual guidance when needed. Flipzy is a routine tool, not a medical device or treatment.</p>"
          }
        },
        "faq_item_cbWwBA": {
          "type": "faq_item",
          "settings": {
            "question": "What routines can Flipzy be used for?",
            "answer": "<p>Flipzy is very flexible. Most families use it for Morning/Evening routines, after-school tasks, chores, or calm transitions. You decide the tasks—Flipzy simply makes them visible.</p>"
          }
        },
        "faq_item_rpDHxN": {
          "type": "faq_item",
          "settings": {
            "question": "Does Flipzy really work?",
            "answer": "<p>Flipzy makes routine steps visible and gives children a way to mark progress. Results vary. Parents still guide, practise and adjust the routine with their child.</p>"
          }
        },
        "faq_item_Bfz7Tj": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need to explain Flipzy to my child?",
            "answer": "<p>Introduce it during a calm moment and practise the steps together. Show that flipping a tile means the task is done. Repeat or simplify the routine whenever your child needs support.</p>"
          }
        },
        "faq_item_YNGFBQ": {
          "type": "faq_item",
          "settings": {
            "question": "Is Flipzy a reward system?",
            "answer": "<p>Flipping tiles shows progress and completion. You can use Flipzy on its own or alongside optional rewards and our printable reward chart. Choose an approach that suits your child.</p>"
          }
        },
        "faq_item_hP9Gy6": {
          "type": "faq_item",
          "settings": {
            "question": "What is Flipzy made of?",
            "answer": "<p>Flipzy has a wooden rail and hinged wooden tiles with rounded edges. Follow the care and safety information supplied with your product.</p>"
          }
        },
        "faq_item_4NyFKC": {
          "type": "faq_item",
          "settings": {
            "question": "Is Flipzy safe?",
            "answer": "<p>Flipzy is for children aged 3+. It contains small parts. Adult setup and supervision are required. Follow the safety information supplied with the product.</p>"
          }
        },
        "faq_item_7PTDmT": {
          "type": "faq_item",
          "settings": {
            "question": "Are the stickers removable?",
            "answer": "<p>Yes. You can change routines anytime or update tasks as your child grows. Extra stickers are available separately.</p>"
          }
        },
        "faq_item_bBkjrh": {
          "type": "faq_item",
          "settings": {
            "question": "Can I buy additional Flipzy boards?",
            "answer": "<p>Yes. Many families use one board per child or separate boards for morning and evening routines. They are available in our shop.</p>"
          }
        },
        "faq_item_cTizKG": {
          "type": "faq_item",
          "settings": {
            "question": "Can I order individual parts?",
            "answer": "<p>At the moment, Flipzy is sold as a complete set. We are exploring individual parts for future versions.</p>"
          }
        },
        "faq_item_PGcGEp": {
          "type": "faq_item",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Orders are normally processed within 1–2 business days, excluding weekends and public holidays. Estimated EU delivery is 3–7 business days after dispatch. These times are estimates, not guaranteed arrival dates. Shipping options and costs appear at checkout. We email tracking when your order ships; allow up to 48 hours for tracking to become active. Read our <a href=\"/policies/shipping-policy\">shipping policy</a>.</p>"
          }
        },
        "faq_item_K7LPGk": {
          "type": "faq_item",
          "settings": {
            "question": "Will I receive an invoice?",
            "answer": "<p>Yes. Invoices are automatically sent to the email address used during checkout. Check your spam or promotions folder if you can't find it.</p>"
          }
        },
        "faq_item_ceHnpG": {
          "type": "faq_item",
          "settings": {
            "question": "What if something is wrong with my order?",
            "answer": "<p>If anything is damaged or missing, please contact us as soon as possible so we can fix it quickly.</p>"
          }
        },
        "faq_item_KtT69z": {
          "type": "faq_item",
          "settings": {
            "question": "Can I return Flipzy?",
            "answer": "<p>Request a return within 30 days of receiving your order by emailing info@flipzy.toys. After the statutory 14-day withdrawal period, items must be unused, undamaged and complete, with original packaging where reasonably possible. You pay change-of-mind return shipping. For defective, damaged or incorrect items, we cover reasonable return costs or provide another appropriate solution. Your statutory rights are unaffected. Read our <a href=\"/policies/refund-policy\">return policy</a> for instructions and refund timing.</p>"
          }
        },
        "faq_item_k9fNFe": {
          "type": "faq_item",
          "settings": {
            "question": "Is Flipzy a toy?",
            "answer": "<p>Flipzy is a physical routine tool for ages 3+. It contains small parts and requires adult setup and supervision. Follow the product safety information.</p>"
          }
        },
        "faq_item_rYyPLn": {
          "type": "faq_item",
          "settings": {
            "question": "Will Flipzy replace parenting?",
            "answer": "<p>No. Flipzy reduces friction, but parents still set expectations and provide guidance. It just takes the pressure off.</p>"
          }
        },
        "faq_item_L6JU7U": {
          "type": "faq_item",
          "settings": {
            "question": "How do I contact you?",
            "answer": "<p>Reach us at info@flipzy.toys. We usually respond within 1–2 business days.</p>"
          }
        }
