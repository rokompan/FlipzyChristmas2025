    "school_faq": {
      "type": "flipzy-faq",
      "blocks": {
        "faq_multiple": {
          "type": "faq_item",
          "settings": {
            "question": "Can a whole preschool group use one Flipzy?",
            "answer": "<p>Yes. Place it where children can see it and use it for shared moments such as arrival, circle time, meals, outdoor play and home time. You can also use Flipzy with a small group or one child.</p>"
          }
        },
        "faq_invoice": {
          "type": "faq_item",
          "settings": {
            "question": "Can we order several boards or request an invoice?",
            "answer": "<p>Yes. Choose the quantity you need above. For a larger order, formal quote or invoice details, email info@flipzy.toys.</p>"
          }
        },
        "faq_change": {
          "type": "faq_item",
          "settings": {
            "question": "Can we change the routine during the day?",
            "answer": "<p>Yes. Rearrange the wooden tiles whenever plans change. Use the included picture stickers to create routines for different parts of the day.</p>"
          }
        },
        "faq_additional": {
          "type": "faq_item",
          "settings": {
            "question": "Can Flipzy support children with additional needs?",
            "answer": "<p>Its visual, tactile format can complement existing support for children who benefit from clear visual sequences. Every child is different; Flipzy is a supportive routine tool, not a medical or therapeutic device.</p>"
          }
        },
        "faq_age": {
          "type": "faq_item",
          "settings": {
            "question": "What ages is Flipzy for?",
            "answer": "<p>Flipzy is designed primarily for children aged 3–8, making it a natural fit for preschool and early primary settings. Older children who benefit from a clear visual sequence may also find it useful.</p>"
          }
        }
      },
