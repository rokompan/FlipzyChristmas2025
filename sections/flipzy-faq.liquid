{% schema %}
{
  "name": "Flipzy FAQ",
  "class": "flipzy-section",
  "settings": [
    { 
      "type": "select", 
      "id": "color_scheme", 
      "label": "Color Scheme", 
      "options": [ 
        { "value": "scheme-white", "label": "White (Clean)" }, 
        { "value": "scheme-cream", "label": "Cream (Warm)" },
        { "value": "scheme-sage", "label": "Sage (Green)" },
        { "value": "scheme-mint", "label": "Mint (Fresh)" },
        { "value": "scheme-night", "label": "Night (Dark Mode)" }
      ], 
      "default": "scheme-white" 
    },
    { "type": "text", "id": "heading", "label": "Section Title", "default": "Frequently Asked Questions (FAQ)" }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Question & Answer",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question text" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer text</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Flipzy FAQ Full",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "What is Flipzy?", "answer": "<p>Flipzy is a hands-on routine board designed to help children complete daily tasks independently—without constant reminders, pressure, or conflict.</p><p>Kids flip wooden tiles as they finish tasks, turning routines into something visual, tactile, and satisfying.</p>" } },
        { "type": "faq_item", "settings": { "question": "What age is Flipzy for?", "answer": "<p>Flipzy is for children aged 3+. It contains small parts and requires adult setup and supervision. Choose routine steps that suit your child’s abilities and support them as they learn.</p>" } },
        { "type": "faq_item", "settings": { "question": "Is Flipzy suitable for children with special needs?", "answer": "<p>Some children find visual routines helpful, but needs vary. Adapt the steps with your child and ask a relevant professional for individual guidance when needed. Flipzy is a routine tool, not a medical device or treatment.</p>" } },
        { "type": "faq_item", "settings": { "question": "What routines can Flipzy be used for?", "answer": "<p>Flipzy is very flexible. Most families use it for: Morning/Evening routines, After-school routines, Chores, or Calm transitions. You decide the tasks—Flipzy simply makes them visible and manageable.</p>" } },
        { "type": "faq_item", "settings": { "question": "Does Flipzy really work?", "answer": "<p>Flipzy makes routine steps visible and gives children a way to mark progress. Results vary. Parents still guide, practise and adjust the routine with their child.</p>" } },
        { "type": "faq_item", "settings": { "question": "Do I need to explain Flipzy to my child?", "answer": "<p>Introduce it during a calm moment and practise the steps together. Show that flipping a tile means the task is done. Repeat or simplify the routine whenever your child needs support.</p>" } },
        { "type": "faq_item", "settings": { "question": "Is Flipzy a reward system?", "answer": "<p>Flipping tiles shows progress and completion. You can use Flipzy on its own or alongside optional rewards and our printable reward chart. Choose an approach that suits your child.</p>" } },
        { "type": "faq_item", "settings": { "question": "What is Flipzy made of?", "answer": "<p>Flipzy has a wooden rail and hinged wooden tiles with rounded edges. Follow the care and safety information supplied with your product.</p>" } },
        { "type": "faq_item", "settings": { "question": "Is Flipzy safe?", "answer": "<p>Flipzy is for children aged 3+. It contains small parts. Adult setup and supervision are required. Follow the safety information supplied with the product.</p>" } },
        { "type": "faq_item", "settings": { "question": "Are the stickers removable?", "answer": "<p>Yes. The stickers are removable and replaceable. You can change routines anytime or update tasks as your child grows. Extra stickers are available separately.</p>" } },
        { "type": "faq_item", "settings": { "question": "Can I buy additional Flipzy boards?", "answer": "<p>Yes. Many families use one board per child or separate boards for morning and evening routines. Additional boards can be purchased from our shop.</p>" } },
        { "type": "faq_item", "settings": { "question": "Can I order individual parts?", "answer": "<p>At the moment, Flipzy is sold as a complete set. Individual replacement parts are not available yet, but we’re actively exploring this for future versions.</p>" } },
        { "type": "faq_item", "settings": { "question": "How long does shipping take?", "answer": "<p>Orders are normally processed within 1–2 business days, excluding weekends and public holidays. Estimated EU delivery is 3–7 business days after dispatch. These times are estimates, not guaranteed arrival dates. Shipping options and costs appear at checkout. We email tracking when your order ships; allow up to 48 hours for tracking to become active. Read our <a href=\"/policies/shipping-policy\">shipping policy</a>.</p>" } },
        { "type": "faq_item", "settings": { "question": "Will I receive an invoice?", "answer": "<p>Yes. Invoices are automatically sent to the email address used during checkout. Check your spam if it’s missing, or contact us to resend it.</p>" } },
        { "type": "faq_item", "settings": { "question": "What if something is wrong with my order?", "answer": "<p>If anything isn’t right—damaged item or missing parts—please contact us as soon as possible. We’ll do our best to fix the situation quickly.</p>" } },
        { "type": "faq_item", "settings": { "question": "Can I return Flipzy?", "answer": "<p>Request a return within 30 days of receiving your order by emailing info@flipzy.toys. After the statutory 14-day withdrawal period, items must be unused, undamaged and complete, with original packaging where reasonably possible. You pay change-of-mind return shipping. For defective, damaged or incorrect items, we cover reasonable return costs or provide another appropriate solution. Your statutory rights are unaffected. Read our <a href=\"/policies/refund-policy\">return policy</a> for instructions and refund timing.</p>" } },
        { "type": "faq_item", "settings": { "question": "Is Flipzy a toy?", "answer": "<p>Flipzy is a physical routine tool for ages 3+. It contains small parts and requires adult setup and supervision. Follow the product safety information.</p>" } },
        { "type": "faq_item", "settings": { "question": "Will Flipzy replace parenting?", "answer": "<p>No—and it’s not meant to. Flipzy helps reduce daily friction, but parents still set expectations and provide guidance. Flipzy simply takes some pressure off.</p>" } },
        { "type": "faq_item", "settings": { "question": "How do I contact you?", "answer": "<p>You can reach us anytime at: info@flipzy.toys. We usually respond within 1–2 business days.</p>" } }
      ]
    }
  ]
}
{% endschema %}

<div id="Flipzy-FAQ-{{ section.id }}" class="flipzy-faq-section {{ section.settings.color_scheme }}">
  <div class="flipzy-faq-inner">
    {% if section.settings.heading != blank %}
      <h2 class="flipzy-faq-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="flipzy-faq-list">
      {% for block in section.blocks %}
        <div class="flipzy-faq-item" {{ block.shopify_attributes }}>
          <button
            id="Flipzy-FAQ-Trigger-{{ section.id }}-{{ block.id }}"
            class="flipzy-faq-trigger"
            type="button"
            aria-expanded="false"
            aria-controls="Flipzy-FAQ-Content-{{ section.id }}-{{ block.id }}"
          >
            <span class="flipzy-faq-question">{{ block.settings.question }}</span>
            <span class="flipzy-faq-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div
            id="Flipzy-FAQ-Content-{{ section.id }}-{{ block.id }}"
            class="flipzy-faq-content"
            role="region"
            aria-labelledby="Flipzy-FAQ-Trigger-{{ section.id }}-{{ block.id }}"
            hidden
            style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;"
          >
            <div class="flipzy-faq-answer">{{ block.settings.answer }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
/* Section Sizing */
.flipzy-faq-section { padding: 60px 20px; }
.flipzy-faq-inner { max-width: 850px; margin: 0 auto; }

/* Heading Stylings */
.flipzy-faq-heading { 
    text-align: center; 
    margin-bottom: 50px; 
    font-family: 'Poppins', sans-serif;
    font-size: 42px; 
    font-weight: 700;
    line-height: 1.2;
}

.flipzy-faq-item { border-bottom: 1px solid rgba(0,0,0,0.1); }

/* Question Stylings */
.flipzy-faq-trigger { 
    width: 100%; display: flex; justify-content: space-between; align-items: center; 
    padding: 24px 0; background: none; border: none; cursor: pointer; text-align: left;
    font-family: 'Poppins', sans-serif;
    font-size: 24px; 
    font-weight: 400; 
    font-style: normal;
    color: inherit; gap: 20px;
}

.flipzy-faq-icon { transition: transform 0.3s ease; flex-shrink: 0; opacity: 0.5; }
.flipzy-faq-trigger[aria-expanded="true"] .flipzy-faq-icon { transform: rotate(180deg); }

/* Answer Stylings */
.flipzy-faq-answer { 
    padding-bottom: 24px; 
    font-family: 'Poppins', sans-serif;
    font-size: 15px; 
    font-weight: 400;
    font-style: normal;
    line-height: 1.6; 
}
.flipzy-faq-answer p { margin: 0 0 1em 0; }
.flipzy-faq-answer p:last-child { margin-bottom: 0; }
.flipzy-faq-answer ul { margin: 10px 0; padding-left: 20px; }

/* Color Schemes from flipzy-feature-video.liquid  */
.scheme-night { background: #1a1a1a; color: #ffffff; }
.scheme-night .flipzy-faq-item { border-color: rgba(255,255,255,0.1); }
.scheme-cream { background: #fdfaf5; color: #333333; }
.scheme-sage { background: #e1e8e1; color: #2d3b2d; }
.scheme-mint { background: #f0f7f4; color: #2d3b2d; }
.scheme-white { background: #ffffff; color: #1a1a1a; }

@media (max-width: 768px) {
    .flipzy-faq-heading { font-size: 32px; }
    .flipzy-faq-trigger { font-size: 18px; }
}
</style>

<script>
(() => {
  const initFlipzyFaq = (faq) => {
    if (!faq || faq.dataset.ready === 'true') return;
    faq.dataset.ready = 'true';

    faq.querySelectorAll('.flipzy-faq-trigger').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
        const content = trigger.nextElementSibling;

        trigger.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
        if (isExpanded) {
          content.style.maxHeight = '0';
          window.setTimeout(() => {
            if (trigger.getAttribute('aria-expanded') === 'false') content.hidden = true;
          }, 310);
        } else {
          content.hidden = false;
          window.requestAnimationFrame(() => {
            content.style.maxHeight = `${content.scrollHeight}px`;
          });
        }
      });
    });
  };

  const initCurrentFaq = () => initFlipzyFaq(document.getElementById('Flipzy-FAQ-{{ section.id }}'));

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCurrentFaq, { once: true });
  } else {
    initCurrentFaq();
  }

  if (!window.flipzyFaqSectionListenerReady) {
    window.flipzyFaqSectionListenerReady = true;
    document.addEventListener('shopify:section:load', (event) => {
      const loadedFaq = event.target.matches('.flipzy-faq-section')
        ? event.target
        : event.target.querySelector('.flipzy-faq-section');
      initFlipzyFaq(loadedFaq);
    });
  }
})();
</script>
